# Meta API Configuration
META_ACCESS_TOKENS=your_token_1,your_token_2,your_token_3,your_token_4
META_API_VERSION=v23.0

# Rate Limiting
MAX_CONCURRENT_REQUESTS=5
BASE_BACKOFF_SECONDS=2
MAX_BACKOFF_SECONDS=300

# Database Configuration
SQLITE_DB_PATH=data/meta_ads.db
ENABLE_CSV_DEBUG=false
ENABLE_AUTO_SCHEMA_CREATION=true

# Job Processing
MAX_JOB_WORKERS=3
JOB_TIMEOUT_MINUTES=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json